name: Build Jan Manch Final Pro Edition
on: [push, workflow_dispatch]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3

      - uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.19.0'
          channel: 'stable'
          cache: true

      - name: Setup Manifest and Source Code
        run: |
          mkdir -p lib
          mkdir -p android/app/src/main

          # 1. pubspec.yaml with compatible dependencies
          cat > pubspec.yaml << 'EOF'
          name: jan_manch
          description: "Jan Manch Janta Ki Awaz"
          publish_to: 'none'
          version: 1.0.0+1

          environment:
            sdk: '>=3.0.0 <4.0.0'

          dependencies:
            flutter:
              sdk: flutter
            http: ^1.1.0
            video_player: ^2.8.0
            chewie: ^1.7.0
            flutter_inappwebview: ^6.0.0
            permission_handler: ^11.0.0
            path_provider: ^2.1.0
            dio: ^5.3.0
            shared_preferences: ^2.2.0
            google_mobile_ads: ^4.0.0

          flutter:
            uses-material-design: true
          EOF

          # 2. AndroidManifest with YOUR REAL ADMOB APP ID
          cat > android/app/src/main/AndroidManifest.xml << 'EOF'
          <manifest xmlns:android="http://schemas.android.com/apk/res/android"
              package="com.example.jan_manch">
              <uses-permission android:name="android.permission.INTERNET"/>
              <uses-permission android:name="android.permission.CAMERA"/>
              <uses-permission android:name="android.permission.RECORD_AUDIO"/>
              <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
              <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
              <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
              <application
                  android:label="Jan Manch"
                  android:name="${applicationName}"
                  android:icon="@mipmap/ic_launcher"
                  android:usesCleartextTraffic="true">
                  <!-- AAPKI REAL ADMOB APP ID -->
                  <meta-data
                      android:name="com.google.android.gms.ads.APPLICATION_ID"
                      android:value="ca-app-pub-7890271511234567~4876027857"/>
                  <activity
                      android:name=".MainActivity"
                      android:exported="true"
                      android:launchMode="singleTop"
                      android:theme="@style/LaunchTheme"
                      android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
                      android:hardwareAccelerated="true"
                      android:windowSoftInputMode="adjustResize">
                      <meta-data
                        android:name="io.flutter.embedding.android.NormalTheme"
                        android:resource="@style/NormalTheme"/>
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN"/>
                          <category android:name="android.intent.category.LAUNCHER"/>
                      </intent-filter>
                  </activity>
              </application>
          </manifest>
          EOF

          # 3. Complete Fixed Flutter Application lib/main.dart with Pagination & Real Ads
          cat > lib/main.dart << 'EOF'
          import 'dart:async';
          import 'dart:convert';
          import 'dart:io';
          import 'dart:math';
          import 'package:flutter/material.dart';
          import 'package:http/http.dart' as http;
          import 'package:video_player/video_player.dart';
          import 'package:chewie/chewie.dart';
          import 'package:flutter_inappwebview/flutter_inappwebview.dart';
          import 'package:permission_handler/permission_handler.dart';
          import 'package:path_provider/path_provider.dart';
          import 'package:dio/dio.dart';
          import 'package:shared_preferences/shared_preferences.dart';
          import 'package:google_mobile_ads/google_mobile_ads.dart';

          // ========== ADMOB - AAPKI PAISE WALI REAL IDs ==========
          const String ADMOB_APP_ID = "ca-app-pub-7890271511234567~4876027857";
          const String ADMOB_BANNER = "ca-app-pub-7890271511234567/1369633386";
          const String ADMOB_INTER = "ca-app-pub-7890271511234567/7226535623";
          // ========================================================

          const String YT_API_KEY = 'AIzaSyByVAA2VcVGMRrfDSXEdXUHUXPiReJN8BI';
          const String GEMINI_KEY = 'AIzaSyAQAb8RN6ImLQdbG7twxFYTOGuvP5ijyMrActnzbJ8S';

          void main() async {
            WidgetsFlutterBinding.ensureInitialized();
            try {
              await MobileAds.instance.initialize();
            } catch (_) {}
            runApp(const JanManchApp());
          }

          class JanManchApp extends StatelessWidget {
            const JanManchApp({super.key});

            @override
            Widget build(BuildContext context) {
              return MaterialApp(
                title: 'Jan Manch',
                debugShowCheckedModeBanner: false,
                theme: ThemeData(
                  primarySwatch: Colors.orange,
                  scaffoldBackgroundColor: const Color(0xFFF9F9F9),
                  appBarTheme: const AppBarTheme(
                    backgroundColor: Colors.orange,
                    foregroundColor: Colors.white,
                    elevation: 1,
                  ),
                ),
                home: const MainScreen(),
              );
            }
          }

          class MainScreen extends StatefulWidget {
            const MainScreen({super.key});

            @override
            State<MainScreen> createState() => _MainScreenState();
          }

          class _MainScreenState extends State<MainScreen> {
            int _currentIndex = 0;
            BannerAd? _bannerAd;
            InterstitialAd? _interstitialAd;
            int _clickCount = 0;

            // Infinite Scroll Controllers & Data
            final ScrollController _scrollController = ScrollController();
            List> _feedVideos = [];
            List> _offlineVideos = [];
            bool _isLoading = true;
            bool _isLoadingMore = false;
            String? _nextPageToken;

            final TextEditingController _searchCtrl = TextEditingController();
            final TextEditingController _ziniCtrl = TextEditingController();
            final TextEditingController _callRoomCtrl = TextEditingController(text: "JanManchRoom");
            final List> _ziniChat = [];
            bool _ziniLoading = false;

            final Dio _dio = Dio();
            String _selectedCategory = 'All';
            final List<String> _categories = [
              'All',
              'Bhrashtachar',
              'Sadak',
              'Pani',
              'Bijli',
              'School',
              'Hospital'
            ];

            int _totalStorageUsed = 0;
            int _todayDownloadUsed = 0;

            @override
            void initState() {
              super.initState();
              _loadBanner();
              _loadInterstitial();
              _syncDailyLimits();
              _loadFeed();
              _loadOfflineVideos();

              // Infinite scroll listener to load more videos when reaching bottom
              _scrollController.addListener(() {
                if (_scrollController.position.pixels >= _scrollController.position.maxScrollExtent - 200) {
                  _loadMoreVideos();
                }
              });
            }

            @override
            void dispose() {
              _bannerAd?.dispose();
              _interstitialAd?.dispose();
              _searchCtrl.dispose();
              _ziniCtrl.dispose();
              _callRoomCtrl.dispose();
              _scrollController.dispose();
              super.dispose();
            }

            void _loadBanner() {
              _bannerAd = BannerAd(
                adUnitId: ADMOB_BANNER,
                size: AdSize.banner,
                request: const AdRequest(),
                listener: BannerAdListener(
                  onAdFailedToLoad: (ad, err) {
                    ad.dispose();
                    _bannerAd = null;
                  },
                ),
              )..load();
            }

            void _loadInterstitial() {
              InterstitialAd.load(
                adUnitId: ADMOB_INTER,
                request: const AdRequest(),
                adLoadCallback: InterstitialAdLoadCallback(
                  onAdLoaded: (ad) => _interstitialAd = ad,
                  onAdFailedToLoad: (_) => _interstitialAd = null,
                ),
              );
            }

            void _showInterstitial() {
              _clickCount++;
              if (_clickCount % 3 == 0 && _interstitialAd != null) {
                _interstitialAd!.show();
                _loadInterstitial();
              }
            }

            Future<void> _syncDailyLimits() async {
              final prefs = await SharedPreferences.getInstance();
              final todayStr = DateTime.now().toIso8601String().substring(0, 10);
              final lastActiveDate = prefs.getString('last_active_date') ?? '';

              int dailyUsed = prefs.getInt('today_download') ?? 0;
              if (lastActiveDate != todayStr) {
                dailyUsed = 0;
                await prefs.setString('last_active_date', todayStr);
                await prefs.setInt('today_download', 0);
              }

              if (mounted) {
                setState(() {
                  _totalStorageUsed = prefs.getInt('storage_used') ?? 0;
                  _todayDownloadUsed = dailyUsed;
                });
              }
            }

            Future<void> _loadFeed() async {
              setState(() => _isLoading = true);
              try {
                final ytUrl =
                    'https://www.googleapis.com/youtube/v3/videos?part=snippet,statistics&chart=mostPopular&regionCode=IN&maxResults=25&key=$YT_API_KEY';
                final res = await http.get(Uri.parse(ytUrl)).timeout(const Duration(seconds: 8));

                if (res.statusCode == 200) {
                  final data = jsonDecode(res.body);
                  _nextPageToken = data['nextPageToken'];
                  _feedVideos = (data['items'] as List).map((e) {
                    return {
                      'id': e['id'],
                      'title': e['snippet']['title'] ?? 'Mudda',
                      'thumb': e['snippet']['thumbnails']['high']?['url'] ??
                          e['snippet']['thumbnails']['default']['url'],
                      'channel': e['snippet']['channelTitle'] ?? 'Jan Manch User',
                      'type': 'youtube',
                      'videoId': e['id'],
                      'category': _categories[Random().nextInt(_categories.length - 1) + 1],
                      'views': e['statistics']?['viewCount'] ?? '1000'
                    };
                  }).toList();
                } else {
                  _generateMockFeed();
                }
              } catch (_) {
                _generateMockFeed();
              }

              // In-App sample playable video inject
              _feedVideos.insert(0, {
                'id': 'app_demo_01',
                'title': 'Sadak Nirman Me Bhrashtachar - Ground Reality Check',
                'thumb': 'https://picsum.photos/320/180?random=101',
                'channel': 'Janta Reporter',
                'type': 'app',
                'url': 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4',
                'category': 'Sadak',
                'views': '12500'
              });

              if (mounted) setState(() => _isLoading = false);
            }

            // Infinite Scroll Loader (Automatically fetches next page as user scrolls)
            Future<void> _loadMoreVideos() async {
              if (_isLoadingMore || _nextPageToken == null) return;
              setState(() => _isLoadingMore = true);

              try {
                final ytUrl =
                    'https://www.googleapis.com/youtube/v3/videos?part=snippet,statistics&chart=mostPopular&regionCode=IN&maxResults=25&pageToken=$_nextPageToken&key=$YT_API_KEY';
                final res = await http.get(Uri.parse(ytUrl)).timeout(const Duration(seconds: 8));

                if (res.statusCode == 200) {
                  final data = jsonDecode(res.body);
                  _nextPageToken = data['nextPageToken'];
                  final List> moreVideos = (data['items'] as List).map((e) {
                    return {
                      'id': e['id'],
                      'title': e['snippet']['title'] ?? 'Mudda',
                      'thumb': e['snippet']['thumbnails']['high']?['url'] ??
                          e['snippet']['thumbnails']['default']['url'],
                      'channel': e['snippet']['channelTitle'] ?? 'Jan Manch User',
                      'type': 'youtube',
                      'videoId': e['id'],
                      'category': _categories[Random().nextInt(_categories.length - 1) + 1],
                      'views': e['statistics']?['viewCount'] ?? '1000'
                    };
                  }).toList();

                  if (mounted) {
                    setState(() {
                      _feedVideos.addAll(moreVideos);
                      _isLoadingMore = false;
                    });
                  }
                } else {
                  setState(() => _isLoadingMore = false);
                }
              } catch (_) {
                setState(() => _isLoadingMore = false);
              }
            }

            void _generateMockFeed() {
              _feedVideos = List.generate(15, (i) {
                return {
                  'id': 'yt_fallback_$i',
                  'title': 'Janta Ka Mudda ${i + 1} - Lok Awaaz',
                  'thumb': 'https://picsum.photos/320/180?random=$i',
                  'channel': 'Jan Manch News ${i + 1}',
                  'type': 'youtube',
                  'videoId': 'dQw4w9WgXcQ',
                  'category': _categories[i % _categories.length],
                  'views': '${Random().nextInt(50000)}'
                };
              });
            }

            Future<void> _loadOfflineVideos() async {
              final prefs = await SharedPreferences.getInstance();
              final list = prefs.getStringList('downloaded_videos') ?? [];
              if (mounted) {
                setState(() {
                  _offlineVideos = list.map((e) => jsonDecode(e) as Map<String, dynamic>).toList();
                });
              }
            }

            Future<void> _searchVideos(String query) async {
              if (query.trim().isEmpty) {
                _loadFeed();
                return;
              }
              setState(() => _isLoading = true);
              try {
                final url =
                    'https://www.googleapis.com/youtube/v3/search?part=snippet&q=${Uri.encodeComponent(query)}&maxResults=25&key=$YT_API_KEY&type=video';
                final res = await http.get(Uri.parse(url));
                if (res.statusCode == 200) {
                  final data = jsonDecode(res.body);
                  _nextPageToken = data['nextPageToken'];
                  final searchResult = (data['items'] as List).map((e) {
                    final vid = e['id']['videoId'] ?? 'dQw4w9WgXcQ';
                    return {
                      'id': vid,
                      'title': e['snippet']['title'],
                      'thumb': e['snippet']['thumbnails']['high']?['url'] ?? '',
                      'channel': e['snippet']['channelTitle'],
                      'type': 'youtube',
                      'videoId': vid,
                      'category': 'All',
                      'views': 'Verified'
                    };
                  }).toList();

                  if (mounted) {
                    setState(() {
                      _feedVideos = searchResult;
                      _isLoading = false;
                    });
                  }
                }
              } catch (_) {
                if (mounted) setState(() => _isLoading = false);
              }
            }

            Future<void> _downloadVideo(Map<String, dynamic> video) async {
              _showInterstitial();

              if (video['type'] == 'youtube') {
                showDialog(
                  context: context,
                  builder: (_) => AlertDialog(
                    title: const Text('Direct Download Restricted'),
                    content: const Text(
                      'YouTube policy ke tehat seedha local save allow nahi hai. Is video ko Online Stream Player me dekhein.',
                    ),
                    actions: [
                      TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
                      ElevatedButton(
                        style: ElevatedButton.styleFrom(backgroundColor: Colors.red),
                        onPressed: () {
                          Navigator.pop(context);
                          Navigator.push(context, MaterialPageRoute(builder: (_) => YTPlayer(videoId: video['videoId'])));
                        },
                        child: const Text('Stream Now', style: TextStyle(color: Colors.white)),
                      )
                    ],
                  ),
                );
                return;
              }

              if (_totalStorageUsed >= 5120) {
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(content: Text('Storage Full! 5GB quota reached.'), backgroundColor: Colors.red),
                );
                return;
              }
              if (_todayDownloadUsed >= 1024) {
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(content: Text('Aaj ka 1GB download limit poora ho gaya!'), backgroundColor: Colors.orange),
                );
                return;
              }

              await Permission.storage.request();
              await Permission.videos.request();

              try {
                ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Downloading: ${video['title']}')));
                final dir = await getApplicationDocumentsDirectory();
                final savePath = '${dir.path}/${video['id']}.mp4';

                await _dio.download(video['url'], savePath);

                final prefs = await SharedPreferences.getInstance();
                final newVideo = {
                  'id': video['id'],
                  'title': video['title'],
                  'localPath': savePath,
                  'channel': video['channel'],
                  'date': DateTime.now().toIso8601String().substring(0, 10),
                };

                final list = prefs.getStringList('downloaded_videos') ?? [];
                list.add(jsonEncode(newVideo));
                await prefs.setStringList('downloaded_videos', list);

                setState(() {
                  _totalStorageUsed += 35;
                  _todayDownloadUsed += 35;
                });
                await prefs.setInt('storage_used', _totalStorageUsed);
                await prefs.setInt('today_download', _todayDownloadUsed);
                await _loadOfflineVideos();

                if (mounted) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(content: Text('Download Complete! Offline tab me saved hai.'), backgroundColor: Colors.green),
                  );
                }
              } catch (e) {
                if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Download failed: $e')));
              }
            }

            Future<void> _askZini(String query) async {
              final text = query.trim();
              if (text.isEmpty) return;

              setState(() {
                _ziniChat.add({'role': 'user', 'text': text});
                _ziniLoading = true;
                _ziniCtrl.clear();
              });

              try {
                final url =
                    'https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=$GEMINI_KEY';
                final body = {
                  'contents': [
                    {
                      'parts': [
                        {'text': 'Tu Jan Manch ka AI Zini hai. Janta ke muddo par short aur clear Hindi me uttar de: $text'}
                      ]
                    }
                  ]
                };

                final res = await http.post(
                  Uri.parse(url),
                  headers: {'Content-Type': 'application/json'},
                  body: jsonEncode(body),
                ).timeout(const Duration(seconds: 12));

                if (res.statusCode == 200) {
                  final data = jsonDecode(res.body);
                  final ans = data['candidates']?[0]?['content']?['parts']?[0]?['text'] ?? 'Koi jawab nahi mila.';
                  if (mounted) setState(() => _ziniChat.add({'role': 'zini', 'text': ans}));
                } else {
                  if (mounted) setState(() => _ziniChat.add({'role': 'zini', 'text': 'Service busy hai.'}));
                }
              } catch (_) {
                if (mounted) setState(() => _ziniChat.add({'role': 'zini', 'text': 'Internet check karein.'}));
              } finally {
                if (mounted) setState(() => _ziniLoading = false);
              }
            }

            Widget _buildHome() {
              final list = _selectedCategory == 'All'
                  ? _feedVideos
                  : _feedVideos.where((v) => v['category'] == _selectedCategory).toList();

              return Column(
                children: [
                  Padding(
                    padding: const EdgeInsets.all(8.0),
                    child: TextField(
                      controller: _searchCtrl,
                      decoration: InputDecoration(
                        hintText: 'Search mudda, gaon, neta...',
                        prefixIcon: const Icon(Icons.search),
                        border: OutlineInputBorder(borderRadius: BorderRadius.circular(20)),
                        isDense: true,
                        filled: true,
                        fillColor: Colors.white,
                      ),
                      onSubmitted: _searchVideos,
                    ),
                  ),
                  SizedBox(
                    height: 38,
                    child: ListView.builder(
                      scrollDirection: Axis.horizontal,
                      itemCount: _categories.length,
                      itemBuilder: (c, i) => Padding(
                        padding: const EdgeInsets.symmetric(horizontal: 4),
                        child: ChoiceChip(
                          label: Text(_categories[i], style: const TextStyle(fontSize: 12)),
                          selected: _selectedCategory == _categories[i],
                          onSelected: (_) => setState(() => _selectedCategory = _categories[i]),
                          selectedColor: Colors.orange.shade200,
                        ),
                      ),
                    ),
                  ),
                  Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
                    child: Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        Text('Storage: $_totalStorageUsed / 5120 MB', style: const TextStyle(fontSize: 11, fontWeight: FontWeight.bold)),
                        Text('Daily Used: $_todayDownloadUsed / 1024 MB', style: const TextStyle(fontSize: 11)),
                      ],
                    ),
                  ),
                  Expanded(
                    child: _isLoading
                        ? const Center(child: CircularProgressIndicator())
                        : ListView.builder(
                            controller: _scrollController,
                            itemCount: list.length + (_isLoadingMore ? 1 : 0),
                            itemBuilder: (c, i) {
                              if (i == list.length) {
                                return const Padding(
                                  padding: EdgeInsets.all(16.0),
                                  child: Center(child: CircularProgressIndicator(color: Colors.orange)),
                                );
                              }
                              final v = list[i];
                              return Card(
                                margin: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                                child: ListTile(
                                  leading: Image.network(
                                    v['thumb'],
                                    width: 80,
                                    height: 55,
                                    fit: BoxFit.cover,
                                    errorBuilder: (_, __, ___) => Container(width: 80, height: 55, color: Colors.grey.shade300),
                                  ),
                                  title: Text(v['title'], maxLines: 2, overflow: TextOverflow.ellipsis, style: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold)),
                                  subtitle: Text('${v['channel']} • ${v['category']}', style: const TextStyle(fontSize: 10)),
                                  trailing: IconButton(
                                    icon: Icon(v['type'] == 'app' ? Icons.download : Icons.ondemand_video,
                                        color: v['type'] == 'app' ? Colors.green : Colors.red),
                                    onPressed: () => _downloadVideo(v),
                                  ),
                                  onTap: () {
                                    _showInterstitial();
                                    if (v['type'] == 'youtube') {
                                      Navigator.push(context, MaterialPageRoute(builder: (_) => YTPlayer(videoId: v['videoId'])));
                                    } else {
                                      Navigator.push(context, MaterialPageRoute(builder: (_) => NativePlayer(url: v['url'], title: v['title'], isLocal: false)));
                                    }
                                  },
                                ),
                              );
                            },
                          ),
                  ),
                ],
              );
            }

            Widget _buildZini() {
              return Column(
                children: [
                  Container(
                    padding: const EdgeInsets.all(12),
                    color: Colors.orange.shade100,
                    child: const Row(
                      children: [
                        CircleAvatar(backgroundColor: Colors.orange, child: Text('Z', style: TextStyle(color: Colors.white))),
                        SizedBox(width: 10),
                        Text('Mera Zini - AI Salahkaar', style: TextStyle(fontWeight: FontWeight.bold)),
                      ],
                    ),
                  ),
                  Expanded(
                    child: _ziniChat.isEmpty
                        ? const Center(child: Text('Zini se janta ke mudde par baat karein'))
                        : ListView.builder(
                            itemCount: _ziniChat.length,
                            itemBuilder: (c, i) {
                              final isUser = _ziniChat[i]['role'] == 'user';
                              return Align(
                                alignment: isUser ? Alignment.centerRight : Alignment.centerLeft,
                                child: Container(
                                  margin: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                                  padding: const EdgeInsets.all(10),
                                  decoration: BoxDecoration(
                                    color: isUser ? Colors.orange.shade400 : Colors.white,
                                    borderRadius: BorderRadius.circular(10),
                                  ),
                                  child: Text(_ziniChat[i]['text']!, style: TextStyle(color: isUser ? Colors.white : Colors.black)),
                                ),
                              );
                            },
                          ),
                  ),
                  if (_ziniLoading) const Padding(padding: EdgeInsets.all(8), child: CircularProgressIndicator()),
                  Padding(
                    padding: const EdgeInsets.all(8),
                    child: Row(
                      children: [
                        Expanded(
                          child: TextField(
                            controller: _ziniCtrl,
                            decoration: const InputDecoration(hintText: 'Sawaal puchein...', border: OutlineInputBorder(), isDense: true),
                            onSubmitted: _askZini,
                          ),
                        ),
                        IconButton(icon: const Icon(Icons.send, color: Colors.orange), onPressed: () => _askZini(_ziniCtrl.text)),
                      ],
                    ),
                  ),
                ],
              );
            }

            Widget _buildOfflineDownloads() {
              return _offlineVideos.isEmpty
                  ? const Center(child: Text('Koi offline video download nahi hai.\nHome tab se video download karein.'))
                  : ListView.builder(
                      itemCount: _offlineVideos.length,
                      itemBuilder: (c, i) {
                        final v = _offlineVideos[i];
                        return Card(
                          margin: const EdgeInsets.symmetric(horizontal: 10, vertical: 5),
                          child: ListTile(
                            leading: const Icon(Icons.offline_pin, color: Colors.green, size: 36),
                            title: Text(v['title'], style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 13)),
                            subtitle: Text('Downloaded: ${v['date']} • Saved on Storage'),
                            trailing: const Icon(Icons.play_circle_fill, color: Colors.orange, size: 36),
                            onTap: () {
                              Navigator.push(
                                context,
                                MaterialPageRoute(
                                  builder: (_) => NativePlayer(url: v['localPath'], title: v['title'], isLocal: true),
                                ),
                              );
                            },
                          ),
                        );
                      },
                    );
            }

            Widget _buildLiveCall() {
              return Center(
                child: Padding(
                  padding: const EdgeInsets.all(20.0),
                  child: Column(
