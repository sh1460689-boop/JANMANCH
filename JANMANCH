          class WebRTCCallScreen extends StatelessWidget {
            final String roomName;
            const WebRTCCallScreen({super.key, required this.roomName});

            @override
            Widget build(BuildContext context) {
              final cleanRoom = roomName.isEmpty ? "JanManchPublicRoom" : roomName;
              return Scaffold(
                appBar: AppBar(title: Text('Live Call: $cleanRoom'), backgroundColor: Colors.green),
                body: InAppWebView(
                  initialUrlRequest: URLRequest(url: WebUri('https://meet.jit.si/$cleanRoom')),
                  initialSettings: InAppWebViewSettings(
                    mediaPlaybackRequiresUserGesture: false,
                    allowsInlineMediaPlayback: true,
                    javaScriptEnabled: true,
                  ),
                  onPermissionRequest: (controller, request) async {
                    return PermissionResponse(
                      resources: request.resources,
                      action: PermissionResponseAction.GRANT,
                    );
                  },
                ),
              );
            }
          }

          class YTPlayer extends StatelessWidget {
            final String videoId;
            const YTPlayer({super.key, required this.videoId});

            @override
            Widget build(BuildContext context) {
              return Scaffold(
                appBar: AppBar(title: const Text('YouTube Streaming'), backgroundColor: Colors.red),
                body: InAppWebView(
                  initialUrlRequest: URLRequest(url: WebUri('https://www.youtube.com/watch?v=$videoId')),
                  initialSettings: InAppWebViewSettings(javaScriptEnabled: true),
                ),
              );
            }
          }

          class NativePlayer extends StatefulWidget {
            final String url;
            final String title;
            final bool isLocal;
            const NativePlayer({super.key, required this.url, required this.title, required this.isLocal});

            @override
            State<NativePlayer> createState() => _NativePlayerState();
          }

          class _NativePlayerState extends State<NativePlayer> {
            VideoPlayerController? _vCtrl;
            ChewieController? _cCtrl;

            @override
            void initState() {
              super.initState();
              if (widget.isLocal) {
                _vCtrl = VideoPlayerController.file(File(widget.url));
              } else {
                _vCtrl = VideoPlayerController.networkUrl(Uri.parse(widget.url));
              }

              _vCtrl!.initialize().then((_) {
                if (mounted) {
                  setState(() {
                    _cCtrl = ChewieController(videoPlayerController: _vCtrl!, autoPlay: true);
                  });
                }
              });
            }

            @override
            void dispose() {
              _vCtrl?.dispose();
              _cCtrl?.dispose();
              super.dispose();
            }

            @override
            Widget build(BuildContext context) {
              return Scaffold(
                appBar: AppBar(title: Text(widget.title), backgroundColor: Colors.orange),
                body: _cCtrl != null && _vCtrl!.value.isInitialized
                    ? Chewie(controller: _cCtrl!)
                    : const Center(child: CircularProgressIndicator()),
              );
            }
          }
